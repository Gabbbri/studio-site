---
interface Props { kind?: string; name: string; sector: string; tone: 'blue'|'forest'|'sand'; number?: string }
const { kind='Concept', name, sector, tone, number } = Astro.props;
---
<article class={`demo-frame demo-${tone}`}>
  <div class="demo-top"><span>{kind}</span>{number && <b>{number}</b>}</div>
  <div class="demo-browser"><i></i><i></i><i></i><small>{sector}</small><strong>{name}</strong><em>Esplora il progetto ↗</em></div>
  <footer><h3>{name}</h3><p>{sector}</p><b>↗</b></footer>
</article>
