---
import DemoFrame from './DemoFrame.astro';
import ExploreSwitcher from './ExploreSwitcher.astro';
interface Props { variant: 1|2|3|4|5 }
const { variant } = Astro.props;
const demos = [
  {kind:'Progetto reale',name:'Appartamenti Tiziana',sector:'Ospitalità · Val di Sole',tone:'blue' as const},
  {kind:'Concept',name:'Selva',sector:'B&B · Dolomiti',tone:'forest' as const},
  {kind:'Concept',name:'Materia',sector:'Artigiani · Trentino',tone:'sand' as const},
];
---
<div class={`explore explore-${variant}`}>
  <ExploreSwitcher active={variant} />

  {variant===1 && <>
    <section class="e1-hero" id="top"><nav><a class="logo" href="#top">studio.</a><div><a href="#showroom">Progetti</a><a href="#approach">Come lavoriamo</a><a href="#offer">Cosa facciamo</a></div><a class="project-button" href="#contact">Inizia un progetto <span>↗</span></a></nav><div class="ghost-type">PIÙ SEMPLICE</div><div class="hero-copy"><span>SITI WEB PER PICCOLE ATTIVITÀ · TRENTINO</span><h1>Il tuo lavoro merita<br/>un sito <em>fatto bene.</em></h1><p>Ti guidiamo dall'idea alla pubblicazione, trasformando quello che rende speciale la tua attività in un sito chiaro, riconoscibile e pronto a lavorare.</p><div><a class="green-action" href="#showroom">Guarda cosa sappiamo fare <i>↓</i></a><a class="text-action" href="#approach">Come funziona</a></div></div><aside class="hero-trust"><span>Un solo referente</span><span>Costi chiari</span><span>Il sito resta tuo</span></aside></section>
    <div class="motion-strip"><div>DESIGN SU MISURA · CONTENUTI · SVILUPPO · SEO · PUBBLICAZIONE · SUPPORTO ·</div><div>DESIGN SU MISURA · CONTENUTI · SVILUPPO · SEO · PUBBLICAZIONE · SUPPORTO ·</div></div>
    <section class="e1-intro" id="approach"><small>Un sito senza diventare project manager</small><h2>Tu conosci la tua attività.<br/><em>Noi sappiamo come raccontarla online.</em></h2><div><p>Non devi imparare termini tecnici, scegliere plugin o capire da solo cosa serve. Facciamo ordine, prendiamo le decisioni insieme e costruiamo il progetto.</p><ul><li><b>01</b>Ci racconti cosa fai</li><li><b>02</b>Ti mostriamo una direzione</li><li><b>03</b>Costruiamo e pubblichiamo</li></ul></div></section>
    <section class="e1-showroom" id="showroom"><header><div><small>Made by us · progetti e concept</small><h2>Prima guarda.<br/><em>Poi parliamo.</em></h2></div><p>Non devi fidarti di una promessa. Esplora siti reali e concept navigabili costruiti per attività come la tua.</p></header><div class="showroom-grid"><DemoFrame {...demos[0]} number="01 / 03"/><DemoFrame {...demos[1]} number="02 / 03"/><DemoFrame {...demos[2]} number="03 / 03"/></div></section>
    <section class="e1-offer" id="offer"><small>Una soluzione completa</small><h2>Tutto ciò che serve.<br/>Niente caos in più.</h2><div><article><b>01</b><h3>Direzione e contenuti</h3><p>Struttura, messaggi, materiali e percorso del cliente.</p></article><article><b>02</b><h3>Design e sviluppo</h3><p>Identità su misura, mobile, velocità e codice pulito.</p></article><article><b>03</b><h3>Visibilità e lancio</h3><p>SEO tecnica, dominio, pubblicazione e controlli.</p></article><article><b>04</b><h3>Supporto reale</h3><p>Decidiamo insieme come aggiornare il sito dopo.</p></article></div></section>
    <section class="final-cta" id="contact"><small>Niente brief da trenta pagine</small><h2>Parliamo<br/>del tuo sito.</h2><p>Raccontaci la tua attività. Ti aiutiamo a capire il progetto giusto, senza gergo e senza impegno.</p><a class="green-action" href="mailto:ciao@example.it">Inizia un progetto <i>↗</i></a></section>
  </>}

  {variant===2 && <>
    <section class="e2-hero" id="top"><nav><a class="logo" href="#top">studio.</a><div><a href="#showroom">Showroom</a><a href="#method">Metodo</a><a href="#contact">Contatti</a></div><a class="project-button" href="#contact">Parliamo del tuo sito <span>↗</span></a></nav><div class="ghost-type">GUARDA</div><header><span>WEB DESIGN · SVILUPPO · VAL DI SOLE</span><h1>Siti semplici da capire.<br/><em>Difficili da dimenticare.</em></h1><p>Strategia, contenuti, design e tecnologia: un unico progetto, seguito dall'inizio alla pubblicazione.</p></header><div class="hero-gallery"><div class="hero-demo hd-one"><span>PROGETTO REALE</span><strong>Appartamenti<br/>Tiziana</strong><small>Ospitalità · Val di Sole</small></div><div class="hero-demo hd-two"><span>CONCEPT</span><strong>Selva</strong><small>B&B · Dolomiti</small></div><div class="hero-demo hd-three"><span>CONCEPT</span><strong>Materia</strong><small>Artigiani · Trentino</small></div></div><a class="green-action floating-action" href="#showroom">Esplora i progetti <i>↓</i></a></section>
    <div class="motion-strip light"><div>PROGETTI REALI · CONCEPT NAVIGABILI · DESIGN SU MISURA · PROGETTI REALI ·</div><div>PROGETTI REALI · CONCEPT NAVIGABILI · DESIGN SU MISURA · PROGETTI REALI ·</div></div>
    <section class="e2-proof"><small>Il nostro lavoro, prima delle promesse</small><h2>Ogni progetto è un equilibrio tra ciò che vuoi raccontare e ciò che il cliente deve capire.</h2><div><span><b>01</b>Identità riconoscibile</span><span><b>02</b>Esperienza immediata</span><span><b>03</b>Tecnologia invisibile</span><span><b>04</b>Supporto dall'inizio</span></div></section>
    <section class="e2-showroom" id="showroom"><header><small>Showroom · 2026</small><h2>Esplora quello<br/>che possiamo fare.</h2><p>Concept dichiarati, progetti reali e siti navigabili. Nessun cliente o risultato inventato.</p></header><div class="showroom-grid"><DemoFrame {...demos[0]} number="01"/><DemoFrame {...demos[1]} number="02"/><DemoFrame {...demos[2]} number="03"/></div></section>
    <section class="e2-method" id="method"><div><small>Dall'idea al sito</small><h2>Quattro passaggi.<br/><em>Un solo referente.</em></h2></div><ol><li><b>01</b><span><strong>Confronto</strong>Attività, pubblico e obiettivi.</span></li><li><b>02</b><span><strong>Direzione</strong>Struttura, stile e contenuti.</span></li><li><b>03</b><span><strong>Costruzione</strong>Design, sviluppo e revisioni.</span></li><li><b>04</b><span><strong>Pubblicazione</strong>SEO, dominio e supporto.</span></li></ol></section>
    <section class="e2-reassurance"><small>Non devi occuparti di tutto</small><h2>Il sito è un nostro lavoro.<br/>Non un altro lavoro per te.</h2><p>Ti diciamo cosa serve, organizziamo i materiali e rendiamo ogni scelta comprensibile. Prima di iniziare conosci tempi, costi e cosa riceverai.</p><a class="green-action" href="#contact">Scopri il tuo progetto <i>↗</i></a></section>
    <section class="final-cta" id="contact"><small>Cominciamo da una conversazione</small><h2>Hai un progetto<br/>in mente?</h2><a class="green-action" href="mailto:ciao@example.it">Parliamo del tuo sito <i>↗</i></a></section>
  </>}

  {variant===3 && <>
    <section class="e3-hero" id="top"><nav><a class="logo" href="#top">studio.</a><div><a href="#work">Lavori</a><a href="#included">Cosa comprende</a><a href="#answers">Domande</a></div><a class="project-button" href="#contact">Parliamo del tuo sito <span>↗</span></a></nav><div class="ghost-type repeated">CHIARO CHIARO CHIARO</div><div class="e3-copy"><span>SITI WEB PROFESSIONALI · SENZA COMPLICAZIONI</span><h1>Ti serve un sito.<br/><em>Non un problema in più.</em></h1><p>Partiamo dalla tua attività, non dalla tecnologia. Ti guidiamo nelle scelte e costruiamo un sito completo, bello da vedere e facile da capire.</p><div><a class="green-action" href="#work">Guarda i progetti <i>↓</i></a><a class="outline-action" href="#included">Scopri cosa compri</a></div><aside><b>Preventivo leggibile</b><b>Un solo referente</b><b>Proprietà chiara</b></aside></div></section>
    <div class="motion-strip"><div>DAL PRIMO CONFRONTO ALLA PUBBLICAZIONE · DAL PRIMO CONFRONTO ALLA PUBBLICAZIONE ·</div><div>DAL PRIMO CONFRONTO ALLA PUBBLICAZIONE · DAL PRIMO CONFRONTO ALLA PUBBLICAZIONE ·</div></div>
    <section class="e3-work" id="work"><header><div><small>Prima guarda</small><h2>Non devi immaginare<br/>cosa sappiamo fare.</h2></div><p>Progetti reali e concept navigabili. La prova della qualità viene prima della richiesta di contatto.</p></header><div class="integrated-gallery"><DemoFrame {...demos[0]} number="01 / 03"/><DemoFrame {...demos[1]} number="02 / 03"/><DemoFrame {...demos[2]} number="03 / 03"/></div><a class="gallery-link" href="#">Apri lo showroom completo <span>↗</span></a></section>
    <section class="e3-problem"><div><small>Perché sembra tutto complicato?</small><h2>Un sito contiene molte decisioni.<br/><em>Non devi prenderle da solo.</em></h2></div><div class="question-cloud"><span>Chi scrive i testi?</span><span>Che cos'è l'hosting?</span><span>Come mi trovano su Google?</span><span>Chi aggiorna il sito?</span><span>Quanto tempo serve?</span></div></section>
    <section class="e3-included" id="included"><small>Un progetto, tutte le parti</small><h2>Un sito completo.<br/>Non una scatola vuota.</h2><p>Quello che normalmente viene venduto come una lista di parole tecniche, noi lo trasformiamo in un percorso comprensibile.</p><div><article><b>01</b><h3>Strategia e struttura</h3><p>Obiettivi, clienti, pagine e percorso.</p></article><article><b>02</b><h3>Testi e materiali</h3><p>Informazioni organizzate e supporto ai contenuti.</p></article><article><b>03</b><h3>Design su misura</h3><p>Identità, interfaccia e versione mobile.</p></article><article><b>04</b><h3>Sviluppo e SEO</h3><p>Velocità, codice e struttura per Google.</p></article><article><b>05</b><h3>Pubblicazione</h3><p>Dominio, controlli e messa online.</p></article><article><b>06</b><h3>Gestione</h3><p>Il livello di autonomia sensato per te.</p></article></div></section>
    <section class="e3-answers" id="answers"><small>Carte scoperte</small><h2>Sai cosa succede<br/>prima di iniziare.</h2><div><details open><summary>Quanto costa e quanto tempo serve?</summary><p>Lo decidiamo nel preventivo dopo aver capito il progetto. Tutte le voci, le revisioni e i costi ricorrenti sono scritti.</p></details><details><summary>Dovrò preparare tutto io?</summary><p>No. Ti guidiamo nella raccolta e organizziamo ciò che serve, coordinando eventuali fotografie o contenuti esterni.</p></details><details><summary>Potrò modificare il sito?</summary><p>Possiamo gestirlo noi, rendere modificabili le informazioni frequenti oppure costruire un'area di gestione più completa.</p></details></div></section>
    <section class="final-cta" id="contact"><small>Niente brief infinito</small><h2>Raccontaci<br/>la tua attività.</h2><p>Ti aiutiamo a capire il progetto sensato prima ancora di parlare di tecnologia.</p><a class="green-action" href="mailto:ciao@example.it">Parliamo del tuo sito <i>↗</i></a></section>
  </>}

  {variant===4 && <>
    <section class="e4-hero" id="top"><nav><a class="logo" href="#top">studio.</a><div><a href="#capabilities">Cosa facciamo</a><a href="#work">Showroom</a><a href="#process">Processo</a></div><a class="project-button" href="#contact">Inizia un progetto <span>↗</span></a></nav><div class="ghost-type">POSSIBILE</div><div class="e4-head"><span>CREATIVITÀ + TECNOLOGIA + SUPPORTO</span><h1>Costruiamo esperienze digitali<br/><em>che fanno crescere idee reali.</em></h1><p>Un piccolo studio per attività ambiziose: strategia chiara, design riconoscibile e tecnologia costruita bene.</p></div><div class="capability-orbit"><span>STRATEGIA</span><span>DESIGN</span><span>SVILUPPO</span><span>SEO</span><b>IL TUO<br/>SITO</b></div><a class="green-action e4-main-action" href="#work">Guarda cosa creiamo <i>↓</i></a></section>
    <div class="motion-strip light"><div>ENDLESS POSSIBILITIES · RELIABLE EXPERTISE · REAL SUPPORT · ENDLESS POSSIBILITIES ·</div><div>ENDLESS POSSIBILITIES · RELIABLE EXPERTISE · REAL SUPPORT · ENDLESS POSSIBILITIES ·</div></div>
    <section class="e4-capabilities" id="capabilities"><header><small>Quello che facciamo</small><h2>Creatività dove si vede.<br/><em>Solidità dove serve.</em></h2><p>La tecnologia resta dietro le quinte. Davanti ci sono il tuo lavoro, il tuo cliente e un'esperienza costruita con cura.</p></header><div class="capability-bento"><article class="cb-large"><b>01</b><h3>Un'identità digitale<br/>che ti appartiene.</h3><div class="mini-brand"><span>TYPE</span><strong>Aa</strong><i></i><i></i><i></i></div></article><article><b>02</b><h3>Esperienza immediata.</h3><p>Ogni pagina guida il cliente verso ciò che conta.</p></article><article><b>03</b><h3>Tecnologia affidabile.</h3><p>Veloce, responsive, leggibile e pronta a crescere.</p></article><article class="cb-wide"><b>04</b><h3>Supporto dall'inizio alla pubblicazione.</h3><p>Un referente che traduce complessità in decisioni semplici.</p></article></div></section>
    <section class="e4-work" id="work"><header><small>Made by us</small><h2>Progetti costruiti<br/>per essere esplorati.</h2><p>Lo showroom raccoglie lavori reali e concept dichiarati. Ogni demo mostra un settore, un obiettivo e una direzione diversa.</p></header><div class="showroom-grid"><DemoFrame {...demos[0]} number="01"/><DemoFrame {...demos[1]} number="02"/><DemoFrame {...demos[2]} number="03"/></div></section>
    <section class="e4-process" id="process"><div><small>Il nostro metodo</small><h2>Visione ambiziosa.<br/>Processo comprensibile.</h2></div><ol><li><b>01</b><strong>Scopriamo</strong><span>Attività e opportunità.</span></li><li><b>02</b><strong>Definiamo</strong><span>Direzione e priorità.</span></li><li><b>03</b><strong>Costruiamo</strong><span>Contenuti, design e codice.</span></li><li><b>04</b><strong>Supportiamo</strong><span>Lancio e gestione.</span></li></ol></section>
    <section class="e4-clarity"><small>Ambiziosi, ma con i piedi per terra</small><h2>Prima di iniziare conosci tempi, costi, responsabilità e cosa riceverai.</h2><a class="green-action" href="#contact">Scopri il tuo progetto <i>↗</i></a></section>
    <section class="final-cta" id="contact"><small>Hai un'idea?</small><h2>Costruiamo<br/>qualcosa di bello.</h2><a class="green-action" href="mailto:ciao@example.it">Inizia un progetto <i>↗</i></a></section>
  </>}

  {variant===5 && <>
    <section class="e5-hero" id="top"><nav><a class="logo" href="#top">studio.</a><div><a href="#dialogue">Come funziona</a><a href="#work">Progetti</a><a href="#manage">Gestione</a></div><a class="project-button" href="#contact">Parliamo del tuo sito <span>↗</span></a></nav><div class="ghost-type soft">DA DOVE PARTO?</div><div class="e5-copy"><span>PER CHI HA UN'ATTIVITÀ, NON UN REPARTO MARKETING</span><h1>“Vorrei un sito bello.<br/><em>Ma non so da dove partire.”</em></h1><p>È normale. Il nostro lavoro è proprio accompagnarti: capire cosa serve, organizzare le informazioni e trasformarle in un sito professionale.</p><a class="green-action" href="#dialogue">Ti spieghiamo come <i>↓</i></a></div><div class="conversation-card"><span>Prima domanda</span><p>Di cosa ha davvero bisogno la tua attività?</p><div><b>Farsi trovare</b><b>Presentarsi meglio</b><b>Ricevere contatti</b></div></div></section>
    <div class="motion-strip"><div>UNA CONVERSAZIONE · UNA DIREZIONE · UN SITO COMPLETO · UNA CONVERSAZIONE ·</div><div>UNA CONVERSAZIONE · UNA DIREZIONE · UN SITO COMPLETO · UNA CONVERSAZIONE ·</div></div>
    <section class="e5-dialogue" id="dialogue"><header><small>Non devi conoscere il web</small><h2>Ti facciamo le domande giuste.<br/><em>Tu ci racconti il tuo lavoro.</em></h2></header><div class="dialogue-flow"><article><span>Tu</span><p>“Ho fotografie sparse, testi da rifare e non so quali pagine servono.”</p></article><article class="reply"><span>Noi</span><p>Mettiamo ordine nei materiali, definiamo il percorso e ti mostriamo presto una proposta concreta.</p></article><article><span>Tu</span><p>“E dopo? Ogni modifica diventa un problema?”</p></article><article class="reply"><span>Noi</span><p>No: scegliamo prima il livello di autonomia e assistenza adatto alla tua attività.</p></article></div></section>
    <section class="e5-work" id="work"><header><div><small>Il risultato</small><h2>Siti che parlano<br/>prima di noi.</h2></div><p>Il nostro showroom è il posto in cui puoi valutare davvero qualità, varietà e livello di cura.</p></header><div class="showroom-grid"><DemoFrame {...demos[0]} number="01 / 03"/><DemoFrame {...demos[1]} number="02 / 03"/><DemoFrame {...demos[2]} number="03 / 03"/></div></section>
    <section class="e5-values"><small>Perché lavorare insieme</small><h2>Possibilità creative.<br/>Competenza affidabile.<br/>Supporto vero.</h2><div><p>Ogni progetto può essere diverso, perché diverse sono le attività e le persone che le guidano.</p><p>Le scelte creative poggiano su struttura, prestazioni, accessibilità e visibilità.</p><p>Non spariamo dopo la pubblicazione: concordiamo gestione e aggiornamenti prima del lancio.</p></div></section>
    <section class="e5-manage" id="manage"><small>Il sito dopo il lancio</small><h2>La gestione giusta<br/>è quella che non ti pesa.</h2><div><article><b>01</b><h3>Ce ne occupiamo noi</h3><p>Ci mandi gli aggiornamenti e li pubblichiamo.</p></article><article><b>02</b><h3>Aggiorni ciò che cambia</h3><p>Orari, menu, offerte o disponibilità.</p></article><article><b>03</b><h3>Gestisci in autonomia</h3><p>Se pubblichi spesso, progettiamo uno spazio dedicato.</p></article></div></section>
    <section class="final-cta" id="contact"><small>La prima conversazione è semplice</small><h2>Parliamo<br/>del tuo sito.</h2><p>Nessuna preparazione necessaria. Parti raccontandoci cosa fai.</p><a class="green-action" href="mailto:ciao@example.it">Inizia un progetto <i>↗</i></a></section>
  </>}
</div>
