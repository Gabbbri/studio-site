---
import DemoFrame from './DemoFrame.astro';
interface Props { refined?: boolean }
const { refined = false } = Astro.props;
const demos = [
  { kind:'Progetto reale', name:'Appartamenti Tiziana', sector:'Ospitalità · Val di Sole', tone:'blue' as const },
  { kind:'Concept', name:'Selva', sector:'B&B · Dolomiti', tone:'forest' as const },
  { kind:'Concept', name:'Materia', sector:'Artigiani · Trentino', tone:'sand' as const },
];
---
<div class:list={['studio-home', { refined }]}>
  <section class="hero" id="top">
    <nav class="nav"><a class="logo" href="#top">studio.</a><div class="nav-links"><a href="#showroom">Progetti</a><a href="#processo">Come funziona</a><a href="#gestione">Gestione</a></div><a class="nav-cta" href="#contatti">Parliamo del tuo sito <span>↗</span></a></nav>
    <div class="hero-pattern" aria-hidden="true">PIÙ SEMPLICE · PIÙ CHIARO</div>
    <div class="hero-content"><p class="eyebrow">SITI WEB PER PICCOLE ATTIVITÀ · TRENTINO</p><h1>Un sito professionale.<br/><em>Senza complicarti la vita.</em></h1><p class="hero-lead">Ti guidiamo dall'idea alla pubblicazione. Tu conosci la tua attività; noi la trasformiamo in un sito chiaro, riconoscibile e costruito per farti scegliere.</p><div class="hero-actions"><a class="primary-cta" href="#showroom">Guarda cosa sappiamo fare <i>↓</i></a><a class="secondary-cta" href="#processo">Scopri come lavoriamo</a></div></div>
    <div class="hero-notes"><span>Un solo referente</span><span>Costi decisi prima</span><span>Il sito resta tuo</span></div>
  </section>
  <div class="ticker" aria-label="Servizi"><div>STRATEGIA · CONTENUTI · WEB DESIGN · SVILUPPO · SEO · PUBBLICAZIONE · SUPPORTO ·</div><div aria-hidden="true">STRATEGIA · CONTENUTI · WEB DESIGN · SVILUPPO · SEO · PUBBLICAZIONE · SUPPORTO ·</div></div>

  <section class="intro" id="processo"><p class="section-label">Un sito senza diventare project manager</p><h2>Tu conosci il tuo lavoro.<br/><em>Noi sappiamo come portarlo online.</em></h2><div class="intro-grid"><p>Non devi imparare termini tecnici, scegliere strumenti o arrivare con tutto già pronto. Mettiamo ordine nelle informazioni, ti mostriamo presto una direzione concreta e costruiamo il progetto insieme.</p><ol><li><b>01</b><span><strong>Ci racconti</strong>Attività, clienti e obiettivi.</span></li><li><b>02</b><span><strong>Ti mostriamo</strong>Una proposta da vedere e discutere.</span></li><li><b>03</b><span><strong>Costruiamo</strong>Contenuti, design e sviluppo.</span></li><li><b>04</b><span><strong>Andiamo online</strong>Pubblicazione, SEO e supporto.</span></li></ol></div></section>

  <section class="showroom" id="showroom"><header><div><p class="section-label">Progetti reali e concept navigabili</p><h2>Prima guarda.<br/><em>Poi parliamo.</em></h2></div><p>Non devi fidarti soltanto di una promessa. Lo showroom serve a valutare davvero qualità, varietà e livello di cura prima ancora di contattarci.</p></header><div class="showroom-grid"><DemoFrame {...demos[0]} number="01 / 03"/><DemoFrame {...demos[1]} number="02 / 03"/><DemoFrame {...demos[2]} number="03 / 03"/></div><a class="showroom-link" href="#"><span>Esplora lo showroom completo</span><b>↗</b></a></section>

  <section class="offer"><p class="section-label">Un progetto completo</p><h2>Tutto ciò che serve.<br/>Niente pezzi mancanti.</h2><div class="offer-grid"><article><b>01</b><h3>Strategia e struttura</h3><p>Obiettivi, pubblico, pagine e percorso del cliente.</p></article><article><b>02</b><h3>Testi e materiali</h3><p>Informazioni organizzate e supporto nella raccolta dei contenuti.</p></article><article><b>03</b><h3>Design e sviluppo</h3><p>Identità su misura, versione mobile, velocità e codice pulito.</p></article><article><b>04</b><h3>Visibilità e lancio</h3><p>SEO tecnica, dominio, pubblicazione e controlli finali.</p></article></div></section>

  <section class="management" id="gestione"><div><p class="section-label">Dopo la pubblicazione</p><h2>Il sito resta semplice.<br/><em>Anche per te.</em></h2><p>Non tutti vogliono gestire un sito e non tutti hanno bisogno dello stesso livello di autonomia. Scegliamo la soluzione sensata prima del lancio.</p></div><div class="management-list"><article><b>01</b><div><h3>Ce ne occupiamo noi</h3><p>Ci mandi gli aggiornamenti e pensiamo alla pubblicazione.</p></div></article><article><b>02</b><div><h3>Aggiorni le cose importanti</h3><p>Orari, menu, offerte o altre informazioni frequenti.</p></div></article><article><b>03</b><div><h3>Gestisci in autonomia</h3><p>Se pubblichi spesso, progettiamo uno spazio di gestione dedicato.</p></div></article></div></section>

  <section class="contact" id="contatti"><p class="section-label">Niente brief da trenta pagine</p><h2>Parliamo<br/>del tuo sito.</h2><p>Raccontaci cosa fai. Ti aiutiamo a capire il progetto giusto prima ancora di parlare di tecnologia.</p><a class="primary-cta" href="mailto:ciao@example.it">Inizia un progetto <i>↗</i></a></section>
</div>
