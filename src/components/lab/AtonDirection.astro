---
import LabSwitcher from './LabSwitcher.astro';
---
<div class="aton-site">
  <LabSwitcher active="b" />
  <main id="top">
    <section class="aton-hero">
      <nav><a href="#lavori">Lavori</a><a href="#servizi">Servizi</a><a href="#processo">Processo</a><a href="#studio">Studio</a><a href="#contatti">Contatti</a></nav>
      <div class="aton-sky"><i class="star s1"></i><i class="star s2"></i><i class="star s3"></i><i class="moon"></i></div>
      <div class="aton-signature">Gabriele<br/><em>Studio</em></div>
      <p class="aton-role">WEB DESIGN & DEVELOPMENT<br/>TRENTINO, ITALIA</p>
      <div class="aton-intro"><p>Studio indipendente. Realizzo siti curati e su misura per piccole attività che vogliono distinguersi anche online.</p><a href="#contatti">Inizia un progetto <span>→</span></a></div>
    </section>

    <section class="aton-marquee"><span>WEB DESIGN · SVILUPPO · STRATEGIA · CONTENUTI · SEO ·</span><span>WEB DESIGN · SVILUPPO · STRATEGIA · CONTENUTI · SEO ·</span></section>

    <section class="aton-about" id="studio"><p>Studio personale</p><h2>Sono Gabriele, designer e sviluppatore. Costruisco siti su misura che uniscono identità, chiarezza e codice pulito.</h2></section>

    <section class="aton-services" id="servizi">
      <div class="aton-section-title"><p>Servizi</p><h2>Pensati per attività ambiziose.<br/><em>Costruiti con cura.</em></h2></div>
      <div class="aton-service-grid">
        <article><span>01</span><h3>Direzione e web design.</h3><ul><li>Struttura e percorso</li><li>Art direction e moodboard</li><li>Design su misura</li><li>Versione mobile curata</li></ul></article>
        <article><span>02</span><h3>Sviluppo e lancio.</h3><ul><li>Sito veloce e responsive</li><li>SEO tecnica</li><li>Dominio e pubblicazione</li><li>Supporto dopo il lancio</li></ul></article>
        <article><span>03</span><h3>Contenuti e presenza.</h3><ul><li>Organizzazione dei testi</li><li>Coordinamento foto e social</li><li>Google Business Profile</li><li>Strategia di contatto</li></ul></article>
      </div>
    </section>

    <section class="aton-works" id="lavori">
      <header><div><p>Progetti selezionati · 2026</p><h2>Una selezione di<br/><em>lavori recenti.</em></h2></div><p>Ogni progetto parte da una conversazione, cresce nei dettagli e prende forma nel browser.</p></header>
      <aside><b>Nota sui progetti</b> — I lavori indicati come Concept sono demo autonome create per mostrare cosa sappiamo fare. Non sono clienti o collaborazioni reali.</aside>
      <div class="aton-work-grid">
        <article class="aton-work aton-real"><div class="aton-cover"><span>01 / 03</span><div><small>PROGETTO REALE</small><strong>Appartamenti<br/>Tiziana</strong><p>Ospitalità · Val di Sole · 2026</p></div></div><h3>Appartamenti Tiziana</h3></article>
        <article class="aton-work aton-concept-one"><div class="aton-cover"><span>02 / 03</span><div><small>CONCEPT</small><strong>Selva</strong><p>B&amp;B · Dolomiti · 2026</p></div></div><h3>Selva — Concept ospitalità</h3></article>
        <article class="aton-work aton-concept-two"><div class="aton-cover"><span>03 / 03</span><div><small>CONCEPT</small><strong>Materia</strong><p>Artigiano · Trentino · 2026</p></div></div><h3>Materia — Concept artigiano</h3></article>
      </div>
    </section>

    <section class="aton-process" id="processo"><p>Il processo</p><h2>Quattro fasi.<br/><em>Una direzione.</em></h2><div><article><b>01</b><h3>Confronto</h3><p>Attività, obiettivi, clienti e priorità.</p></article><article><b>02</b><h3>Direzione</h3><p>Struttura, riferimenti, palette e primo concept.</p></article><article><b>03</b><h3>Design e sviluppo</h3><p>Costruiamo e rifiniamo il sito insieme.</p></article><article><b>04</b><h3>Pubblicazione</h3><p>Dominio, SEO, test e supporto.</p></article></div></section>
    <section class="aton-contact" id="contatti"><p>Inizia un progetto</p><h2>Hai qualcosa<br/>in mente?</h2><a href="mailto:ciao@example.it">Scrivimi ↗</a><div><span>Risposta<br/><b>entro 24 ore</b></span><span>Base<br/><b>Val di Sole</b></span><span>Disponibilità<br/><b>Autunno 2026</b></span></div></section>
  </main>
</div>
