---
import { management, projects, steps, studio } from '../../data/studio';

interface Props { variant: 'a' | 'b' | 'c' }
const { variant } = Astro.props;
const labels = {
  a: ['A', 'Editorial clarity'],
  b: ['B', 'Modern showcase'],
  c: ['C', 'Playful precision'],
}[variant];
---
<div class="concept">
  <div class="lab-switcher" aria-label="Direzioni visuali">
    <span>Design lab</span>
    <a class:list={[{active: variant === 'a'}]} href="../a/">A</a>
    <a class:list={[{active: variant === 'b'}]} href="../b/">B</a>
    <a class:list={[{active: variant === 'c'}]} href="../c/">C</a>
  </div>

  <nav class="nav">
    <a class="brand" href="#top" aria-label="Studio Web, torna all’inizio"><i></i>STUDIO WEB</a>
    <div class="nav-links"><a href="#lavori">Lavori</a><a href="#servizio">Come funziona</a><a href="#gestione">Gestione</a></div>
    <a class="button button-small" href="#contatti">Raccontaci la tua attività <span>↗</span></a>
  </nav>

  <main id="top">
    <section class="hero">
      <div class="hero-meta"><span>Trentino · Italia</span><span>Siti per piccole attività</span></div>
      <div class="hero-copy">
        <p class="eyebrow">{studio.audiences.join(' · ')}</p>
        <h1>Siti professionali<br/><em>senza caos.</em></h1>
        <p class="lead">{studio.promise}</p>
        <div class="hero-actions"><a class="button" href="#lavori">Guarda cosa sappiamo fare <span>↓</span></a><a class="soft-link" href="#servizio">Come lavoriamo</a></div>
      </div>
      <div class="hero-showcase" aria-hidden="true">
        <div class="browser-card"><div class="browser-bar"><i></i><i></i><i></i><span>alboschetto.it</span></div><div class="browser-screen"><small>CARCIATO · VAL DI SOLE</small><strong>Ci vediamo<br/>al Boschetto.</strong><span>Un posto semplice. Fatto bene.</span><b>SCOPRI IL POSTO ↗</b></div></div>
        <span class="floating-note">Design che si fa<br/>notare davvero.</span>
      </div>
      <div class="hero-index"><b>{labels[0]}</b><span>{labels[1]}</span></div>
    </section>

    <section class="proof-strip"><span>Chiaro da capire</span><span>Bello da ricordare</span><span>Facile da gestire</span><span>Costruito intorno a te</span></section>

    <section class="work" id="lavori">
      <header class="section-heading"><p class="eyebrow">Lavori e concept</p><h2>Prima guarda.<br/><em>Poi parliamo.</em></h2><p>Non devi immaginare cosa possiamo fare. Esplora progetti reali e demo costruite per attività come la tua.</p></header>
      <div class="project-grid">
        {projects.map((project) => <article class={`project project-${project.tone}`}>
          <div class="project-visual"><span>{project.number} / 03</span><div class="mini-site"><small>{project.sector}</small><strong>{project.name}</strong><i></i><i></i><i></i></div><b>↗</b></div>
          <div class="project-info"><div><span>{project.kind}</span><span>{project.sector}</span></div><h3>{project.name}</h3><p>{project.direction}</p></div>
        </article>)}
      </div>
      <a class="wide-link" href="#">Esplora tutte le demo <span>↗</span></a>
    </section>

    <section class="service" id="servizio">
      <header class="section-heading"><p class="eyebrow">Il nostro lavoro</p><h2>Tu conosci la tua attività.<br/><em>Al sito pensiamo noi.</em></h2></header>
      <div class="service-intro"><p>Non ti consegniamo un editor vuoto e un manuale. Ti guidiamo nelle scelte, organizziamo i contenuti e trasformiamo quello che ci racconti in un sito completo.</p><div class="orbit"><span>Strategia</span><span>Testi</span><span>Design</span><span>SEO</span><b>Il tuo sito</b></div></div>
      <div class="steps">{steps.map(([number, title, copy]) => <article><b>{number}</b><h3>{title}</h3><p>{copy}</p></article>)}</div>
    </section>

    <section class="management" id="gestione">
      <div class="management-copy"><p class="eyebrow">E dopo la pubblicazione?</p><h2>Il sito resta semplice.<br/><em>Anche per te.</em></h2><p>Non tutti vogliono gestire un sito e non tutti hanno bisogno dello stesso livello di autonomia. Scegliamo insieme quello sensato.</p></div>
      <div class="management-list">{management.map(([title, copy], index) => <article><b>0{index + 1}</b><div><h3>{title}</h3><p>{copy}</p></div><span>↗</span></article>)}</div>
    </section>

    <section class="audience"><p class="eyebrow">Lavoriamo bene con</p><div>{studio.audiences.map((item, index) => <span><b>0{index + 1}</b>{item}</span>)}</div></section>

    <section class="contact" id="contatti"><p class="eyebrow">Niente brief da trenta pagine</p><h2>Raccontaci<br/><em>la tua attività.</em></h2><p>Una prima conversazione serve a capire cosa ti serve davvero. Senza gergo, senza impegno e senza farti perdere tempo.</p><a class="button" href="mailto:hello@example.it">Iniziamo da due parole <span>↗</span></a></section>
  </main>
  <footer><a class="brand" href="#top"><i></i>STUDIO WEB</a><span>Trentino · Italia</span><span>© 2026</span></footer>
</div>
