---
import RoundTwoSwitcher from './RoundTwoSwitcher.astro';
interface Props { variant: 1 | 2 | 3 | 4 }
const { variant } = Astro.props;

const projects = [
  ['Progetto reale', 'Appartamenti Tiziana', 'Ospitalità · Val di Sole'],
  ['Concept', 'Selva', 'B&B · Dolomiti'],
  ['Concept', 'Materia', 'Artigiani · Trentino'],
];
---
<div class={`round-two round-two-${variant}`}>
  <RoundTwoSwitcher active={variant} />

  {variant === 1 && <>
    <section class="r1-hero" id="top">
      <nav><b>Gabriele.</b><div><a href="#works">Lavori</a><a href="#services">Servizi</a><a href="#process">Processo</a><a href="#contact">Contatti</a></div></nav>
      <div class="r1-landscape"><i></i><i></i><i></i></div>
      <p class="r1-role">STUDIO INDIPENDENTE<br/>WEB DESIGN & DEVELOPMENT</p>
      <h1>Siti che<br/><em>lasciano il segno.</em></h1>
      <div class="r1-pitch"><p>Progetto esperienze digitali su misura per piccole attività che vogliono distinguersi.</p><a href="#contact">Inizia un progetto <span>→</span></a></div>
    </section>
    <div class="r-marquee">WEB DESIGN · SVILUPPO · STRATEGIA · CONTENUTI · SEO · WEB DESIGN · SVILUPPO · STRATEGIA ·</div>
    <section class="r1-intro"><small>Studio personale · Trentino</small><h2>Identità, chiarezza e codice. Ogni progetto nasce per trasformare una piccola attività in una presenza digitale difficile da ignorare.</h2></section>
    <section class="r1-works" id="works"><header><div><small>Progetti selezionati · 2026</small><h2>Prima guarda.<br/><em>Poi parliamo.</em></h2></div><p>Progetti reali e concept navigabili: il modo più semplice per capire cosa possiamo costruire insieme.</p></header><div class="cinema-grid">{projects.map(([kind,name,sector],index)=><article class={`cinema-card cinema-${index+1}`}><span>0{index+1} / 03</span><div><small>{kind}</small><strong>{name}</strong><p>{sector}</p></div></article>)}</div></section>
    <section class="r1-services" id="services"><small>Servizi</small><h2>Un solo studio.<br/><em>Tutto il sito.</em></h2><div><article><b>01</b><h3>Direzione</h3><p>Strategia, struttura, art direction e contenuti.</p></article><article><b>02</b><h3>Design</h3><p>Interfacce su misura, mobile e identità digitale.</p></article><article><b>03</b><h3>Sviluppo</h3><p>Codice, prestazioni, SEO e pubblicazione.</p></article></div></section>
    <section class="r1-process" id="process"><small>Il processo</small><h2>Quattro fasi.<br/><em>Una direzione.</em></h2><ol><li><b>01</b><span>Confronto</span></li><li><b>02</b><span>Art direction</span></li><li><b>03</b><span>Design e sviluppo</span></li><li><b>04</b><span>Pubblicazione</span></li></ol></section>
    <section class="r1-contact" id="contact"><small>Hai un progetto?</small><h2>Facciamolo<br/><em>bene.</em></h2><a href="mailto:ciao@example.it">Raccontami la tua idea →</a></section>
  </>}

  {variant === 2 && <>
    <header class="r2-nav"><a href="#top"><b>g.</b> studio web</a><nav><a href="#works">Progetti</a><a href="#method">Come funziona</a><a href="#contact">Contatti</a></nav><a class="pill" href="#contact">Parliamo del tuo sito</a></header>
    <section class="r2-hero" id="top"><div><small>WEB DESIGN · VAL DI SOLE</small><h1>Un sito bello da vedere.<br/><em>Semplice da scegliere.</em></h1><p>Aiutiamo piccole attività a presentarsi online con la stessa cura che mettono ogni giorno nel proprio lavoro.</p><a class="light-pill" href="#works">Guarda cosa sappiamo fare <span>↓</span></a></div><div class="r2-show"><span>PROGETTO IN EVIDENZA</span><div><small>APPARTAMENTI TIZIANA</small><strong>La vacanza<br/>comincia qui.</strong><p>Val di Sole · Trentino</p></div></div></section>
    <section class="r2-proof"><span>Un referente</span><span>Progetto su misura</span><span>Costi chiari</span><span>Sito di tua proprietà</span></section>
    <section class="r2-works" id="works"><header><small>Progetti e concept</small><h2>Non ti chiediamo<br/>di immaginare.</h2><p>Prima di contattarci puoi vedere progetti reali e demo costruite per attività come la tua.</p></header><div class="editorial-projects">{projects.map(([kind,name,sector],index)=><article class={`ep-${index+1}`}><div><span>{kind}</span><b>↗</b><strong>{name}</strong></div><footer><h3>{name}</h3><p>{sector}</p></footer></article>)}</div></section>
    <section class="r2-method" id="method"><header><small>Come lavoriamo</small><h2>Tu conosci la tua attività.<br/><em>Al sito pensiamo insieme.</em></h2></header><div class="r2-method-grid"><p>Non ti consegniamo un editor vuoto. Ti guidiamo nelle scelte, organizziamo i materiali e costruiamo tutto ciò che serve per andare online.</p><ol><li><b>01</b><span><strong>Ci racconti</strong>Attività, clienti e obiettivi.</span></li><li><b>02</b><span><strong>Ti mostriamo</strong>Una direzione concreta.</span></li><li><b>03</b><span><strong>Costruiamo</strong>Testi, design e sviluppo.</span></li><li><b>04</b><span><strong>Andiamo online</strong>Pubblicazione e supporto.</span></li></ol></div></section>
    <section class="r2-clarity"><small>Cosa comprende</small><h2>Un progetto completo,<br/>senza pezzi mancanti.</h2><div><span>Strategia</span><span>Struttura</span><span>Design su misura</span><span>Versione mobile</span><span>SEO tecnica</span><span>Pubblicazione</span></div></section>
    <section class="r2-contact" id="contact"><small>Prima conversazione, zero gergo</small><h2>Raccontaci<br/>la tua attività.</h2><p>Ti rispondiamo con le prime domande utili e una direzione chiara.</p><a href="mailto:ciao@example.it">Iniziamo →</a></section>
  </>}

  {variant === 3 && <>
    <header class="r3-nav"><a href="#top">studio.</a><nav><a href="#work">Lavori</a><a href="#included">Cosa facciamo</a><a href="#faq">Domande</a></nav><a href="#contact">Parliamone</a></header>
    <section class="r3-hero" id="top"><div><span>SITI PROFESSIONALI · SENZA CAOS</span><h1>Il tuo sito non dovrebbe essere<br/><em>un altro lavoro da fare.</em></h1><p>Progettiamo, scriviamo e pubblichiamo siti per piccole attività. Tu ci racconti il tuo lavoro; noi lo rendiamo chiaro, credibile e bello da vedere online.</p><div><a href="#work">Guarda i progetti</a><a href="#included">Scopri cosa comprende</a></div><aside><b>Un referente</b><b>Costi decisi prima</b><b>Il sito resta tuo</b></aside></div></section>
    <section class="r3-work" id="work"><header><div><small>Prima le prove</small><h2>Siti da vedere,<br/><em>non da immaginare.</em></h2></div><p>Ogni concept è navigabile ed è dichiarato come demo. Nessun cliente o risultato inventato.</p></header><div class="r3-gallery">{projects.map(([kind,name,sector],index)=><article class={`r3-card r3-card-${index+1}`}><span>{kind}</span><strong>{name}</strong><small>{sector}</small><b>0{index+1}</b></article>)}</div></section>
    <section class="r3-problem"><div><small>Il problema</small><h2>Fare un sito è pieno di domande che nessuno ti spiega.</h2></div><ul><li>Chi prepara testi e fotografie?</li><li>Che differenza c'è tra dominio e hosting?</li><li>Come si confrontano due preventivi?</li><li>Chi aggiorna il sito dopo?</li></ul></section>
    <section class="r3-included" id="included"><small>La risposta</small><h2>Un percorso guidato,<br/>dall'idea alla pubblicazione.</h2><div><article><b>01</b><h3>Mettiamo ordine</h3><p>Obiettivi, pubblico, pagine e materiali necessari.</p></article><article><b>02</b><h3>Costruiamo</h3><p>Testi, design, versione mobile e sviluppo.</p></article><article><b>03</b><h3>Andiamo online</h3><p>Dominio, SEO, pubblicazione e controlli.</p></article><article><b>04</b><h3>Decidiamo la gestione</h3><p>Ce ne occupiamo noi oppure ti diamo l'autonomia che serve.</p></article></div></section>
    <section class="r3-offer"><div><small>Carte scoperte</small><h2>Prima di iniziare sai cosa compri.</h2><p>Preventivo con tempi, servizi inclusi, revisioni, responsabilità e costi ricorrenti.</p></div><aside><span>Ogni progetto comprende</span><strong>Strategia + design<br/>+ sviluppo + lancio</strong><a href="#contact">Richiedi un confronto →</a></aside></section>
    <section class="r3-faq" id="faq"><small>Domande concrete</small><h2>Quello che vuoi sapere,<br/>prima di contattarci.</h2><details open><summary>Devo preparare io tutti i contenuti?</summary><p>No. Raccogliamo insieme le informazioni e coordiniamo eventuali fotografie o contenuti esterni.</p></details><details><summary>Potrò cambiare qualcosa nel sito?</summary><p>Sì: scegliamo se gestiamo noi gli aggiornamenti, se modifichi solo le informazioni frequenti o se vuoi maggiore autonomia.</p></details><details><summary>Quanto tempo servirà?</summary><p>Lo definiamo nel preventivo in base a dimensioni, materiali e velocità delle approvazioni.</p></details></section>
    <section class="r3-contact" id="contact"><small>Niente brief da trenta pagine</small><h2>Raccontaci cosa fai.</h2><a href="mailto:ciao@example.it">Parliamone →</a></section>
  </>}

  {variant === 4 && <>
    <header class="r4-nav"><a href="#top">studio.</a><a href="#contact">Richiedi un confronto</a></header>
    <section class="r4-hero" id="top"><div><span>GUIDA PER PICCOLE ATTIVITÀ · 2026</span><h1>Come si fa un sito web<br/><em>senza impazzire?</em></h1><p>Il mercato ti offre due estremi: fare tutto da solo oppure entrare nei processi di un'agenzia. Noi costruiamo il sito con te, traducendo ogni scelta tecnica in una decisione semplice.</p><div><a href="#solution">Scopri come funziona</a><a href="#projects">Guarda i progetti</a></div><aside><b>Niente gergo</b><b>Nessun costo nascosto</b><b>Il sito è tuo</b></aside></div></section>
    <section class="r4-choice"><small>Le alternative</small><h2>Tre modi per arrivare online.</h2><div class="choice-table"><div><b>Soluzione</b><b>Vantaggio</b><b>Il problema</b></div><div><span>Builder fai da te</span><span>Costo iniziale basso</span><strong>Devi progettare, scrivere e gestire tutto</strong></div><div><span>Agenzia strutturata</span><span>Molte competenze</span><strong>Processo e costo spesso eccessivi</strong></div><div class="selected"><span>Studio indipendente</span><span>Guida e progetto su misura</span><strong>Un referente dall'inizio alla fine</strong></div></div></section>
    <section class="r4-solution" id="solution"><small>La nostra soluzione</small><h2>Non compri “delle pagine”.<br/>Compri un sito pronto a lavorare.</h2><p>Queste sono le parti che devono esserci davvero per evitare sorprese durante e dopo il progetto.</p><div>{[['01','Strategia','Obiettivi, pubblico e percorso.'],['02','Contenuti','Testi e materiali organizzati.'],['03','Design','Progetto su misura e mobile.'],['04','Sviluppo','Velocità, accessibilità e codice.'],['05','Visibilità','SEO tecnica e pubblicazione.'],['06','Gestione','Aggiornamenti decisi insieme.']].map(([n,t,p])=><article><b>{n}</b><h3>{t}</h3><p>{p}</p></article>)}</div></section>
    <section class="r4-projects" id="projects"><small>Prima guarda</small><h2>Il risultato viene<br/>prima del preventivo.</h2><p>Progetti reali e concept navigabili, sempre indicati chiaramente.</p><div>{projects.map(([kind,name,sector],index)=><article class={`r4-card rc-${index+1}`}><span>{kind}</span><strong>{name}</strong><small>{sector}</small></article>)}</div></section>
    <section class="r4-management"><small>Dopo la pubblicazione</small><h2>Chi modifica il sito?</h2><div><article><b>01</b><h3>Ce ne occupiamo noi</h3><p>Ci mandi le modifiche e pensiamo alla pubblicazione.</p></article><article><b>02</b><h3>Aggiorni le cose importanti</h3><p>Orari, menu, offerte o informazioni frequenti.</p></article><article><b>03</b><h3>Gestisci il sito</h3><p>Se pubblichi spesso, costruiamo uno spazio di gestione adatto.</p></article></div></section>
    <section class="r4-faq"><small>Prima di iniziare</small><h2>Le domande giuste.</h2><details open><summary>Quanto costa?</summary><p>Dopo il confronto ricevi una cifra con tutte le voci incluse, i costi ricorrenti e le eventuali opzioni.</p></details><details><summary>Quanto tempo serve?</summary><p>Il calendario viene deciso prima e dipende da complessità, materiali e approvazioni.</p></details><details><summary>Chi possiede il dominio e il sito?</summary><p>Tu. Dominio, contenuti e progetto non diventano strumenti per tenerti legato a noi.</p></details></section>
    <section class="r4-contact" id="contact"><div><small>Prima conversazione</small><h2>Partiamo dalla tua attività,<br/>non dalla tecnologia.</h2><p>Raccontaci cosa fai e cosa vorresti ottenere. Ti aiutiamo a capire il progetto sensato.</p><a href="mailto:ciao@example.it">Iniziamo →</a></div></section>
  </>}
</div>
