---
interface Props { active: 'a' | 'b' | 'c' }
const { active } = Astro.props;
---
<aside class="lab-switcher" aria-label="Confronta le tre direzioni">
  <span>Design lab</span>
  <a class:list={{ active: active === 'a' }} href="../a/">A</a>
  <a class:list={{ active: active === 'b' }} href="../b/">B</a>
  <a class:list={{ active: active === 'c' }} href="../c/">C</a>
</aside>
